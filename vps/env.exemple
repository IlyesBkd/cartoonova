# Secrets des taches automatiques sur le VPS.
#
#   cp vps/env.exemple .env.vps && chmod 600 .env.vps
#
# Ce fichier est un modele, sans valeur. Le vrai `.env.vps` vit a la racine du
# depot, n'est pas versionne, et n'a pas a l'etre : il porte les memes valeurs
# que les secrets GitHub et les variables Vercel.

# ── Base ────────────────────────────────────────────────────────────────
# La meme chaine Neon que Vercel.
DATABASE_URL=

# ── Site ────────────────────────────────────────────────────────────────
SITE_URL=https://www.cartoonova.com
# Le meme mot que dans les variables d'environnement Vercel : les routes
# /api/cron/* le comparent avant de faire quoi que ce soit.
CRON_SECRET=

# ── Generation ──────────────────────────────────────────────────────────
AI_API_KEY=
AI_ENDPOINT=https://api.openai.com/v1/chat/completions
# gpt-5.5 refuse le parametre `temperature` qu'envoie l'adaptateur
# (« only the default (1) value is supported ») ; gpt-5.4 l'accepte.
AI_MODEL=gpt-5.4
AI_TRANSLATION_MODEL=gpt-5.4-mini
AI_ADAPTER=openai-compatible

# ── Decouverte de sujets ────────────────────────────────────────────────
# `corpus+serpapi` lit d'abord la file de 90 sujets derivee du corpus de
# requetes — gratuite, hors ligne, deterministe — et n'ajoute les resultats en
# direct que par-dessus. SERPAPI_API_KEY est donc facultative : sans elle le
# moteur tourne sur le corpus seul, au lieu de s'arreter.
SEARCH_ADAPTER=corpus+serpapi
SERPAPI_API_KEY=

# ── Sondes ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=
PERPLEXITY_API_KEY=

# Search Console (compte de service). La cle privee est en base64 : les sauts
# de ligne d'un PEM ne survivent ni au shell, ni a un fichier .env.
GSC_SITE_URL=https://www.cartoonova.com/
GSC_CLIENT_EMAIL=
GSC_PRIVATE_KEY_B64=

MERCHANT_ACCOUNT_ID=

# PostHog, pour la part haute de l'entonnoir.
POSTHOG=
POSTHOG_PROJET=145750

# ── Alertes ─────────────────────────────────────────────────────────────
# C'est par la qu'arrive tout ce qui demande un oeil. Sans ce webhook, les
# taches tournent mais personne n'apprend rien.
DISCORD_WEBHOOK_URL=
