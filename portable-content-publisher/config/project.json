{
  "version": 1,
  "project": {
    "id": "cartoonova",
    "name": "Cartoonova",
    "siteUrl": "${SITE_URL:-https://www.cartoonova.com}",
    "timezone": "Europe/Paris",
    "topic": "personalized hand-drawn cartoon caricature portraits and gift ideas",
    "description": "Blog Cartoonova : idées cadeaux, guides de style et conseils pratiques autour du portrait caricature personnalisé.",
    "editorial": {
      "voice": "chaleureuse, inspirante, orientée cadeaux, honnête sur les délais et le processus, jamais survendeuse",
      "audience": "personnes cherchant un cadeau original et personnalisé pour un proche, ou clientes déjà convaincues et curieuses des styles disponibles",
      "principles": [
        "toujours relier le sujet à un vrai cas d'usage cadeau ou personnalisation",
        "rester honnête sur les délais annoncés (dessin en 24h, impression et livraison en 3 à 5 jours ouvrés)",
        "éviter le jargon marketing creux, privilégier des conseils concrets et actionnables",
        "mentionner Cartoonova naturellement dans le texte, jamais de façon insistante ou répétée"
      ],
      "forbiddenPatterns": [
        "garanti à 100%",
        "vous ne devinerez jamais",
        "le secret que personne ne vous dit",
        "achetez maintenant avant qu'il ne soit trop tard"
      ]
    }
  },
  "contentTypes": [
    {
      "id": "article",
      "label": "Article de blog",
      "minWords": 700,
      "maxWords": 1600,
      "requiredImages": 2,
      "dailyTargets": { "fr": 1, "en": 1, "es": 1, "de": 1, "it": 1, "nl": 1, "pl": 1, "sv": 1, "da": 1, "pt": 1 },
      "reserveTargets": { "fr": 3, "en": 3, "es": 3, "de": 3, "it": 3, "nl": 2, "pl": 2, "sv": 2, "da": 2, "pt": 2 },
      "categories": ["gift-guides", "style-guides", "how-to"]
    }
  ],
  "locales": [
