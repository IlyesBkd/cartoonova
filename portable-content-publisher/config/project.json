    { "id": "en", "language": "English", "market": "United States", "isDefault": false, "publicationWindows": [{ "start": "09:00", "end": "20:00" }] },
    { "id": "es", "language": "Spanish", "market": "Spain", "isDefault": false, "publicationWindows": [{ "start": "09:00", "end": "20:00" }] },
